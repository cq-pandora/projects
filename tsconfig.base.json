{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2024"],
		"module": "node20",
		"useDefineForClassFields": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"resolveJsonModule": true,
		// "isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"types": ["node"],
	}
}
