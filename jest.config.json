{
	"displayName": "pandora",
	"verbose": true,
	"testEnvironment": "node",
	"transform": {
		"^.+\\.ts$": ["ts-jest", {
			"tsconfig": "<rootDir>/tsconfig.json",
			"diagnostics": {
				"ignoreCodes": [151002]
			}
		}]
	},
	"testMatch": [
		"<rootDir>/shared/*/test/**/*.test.ts",
		"<rootDir>/services/*/test/**/*.test.ts"
	]
}
